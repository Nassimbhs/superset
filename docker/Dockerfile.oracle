#
# Oracle-enabled Superset image for local Docker Compose usage.
#
ARG SUPERSET_BASE_IMAGE=apache/superset:6.1.0
FROM ${SUPERSET_BASE_IMAGE} AS oracle

USER root

ARG INSTANTCLIENT_ZIP=instantclient-basic-linux.x64-23.26.0.0.0.zip
ENV ORACLE_HOME=/opt/oracle/instantclient \
    LD_LIBRARY_PATH=/opt/oracle/instantclient \
    PATH=/opt/oracle/instantclient:${PATH}

RUN apt-get update -qq \
    && apt-get install -yqq --no-install-recommends \
      build-essential \
      libaio1 \
      unzip \
    && rm -rf /var/lib/apt/lists/*

COPY ${INSTANTCLIENT_ZIP} /tmp/instantclient.zip

RUN mkdir -p /opt/oracle \
    && unzip /tmp/instantclient.zip -d /opt/oracle \
    && rm -f /tmp/instantclient.zip \
    && mv /opt/oracle/instantclient_* /opt/oracle/instantclient \
    && mkdir -p /opt/oracle/instantclient/lib \
    && cd /opt/oracle/instantclient/lib \
    && for lib in ../*.so*; do ln -sf "$lib" .; done \
    && ln -sfn /opt/oracle/instantclient /opt/oracle/instantclient_23_26 \
    && echo /opt/oracle/instantclient > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig

# Superset 5+ images run from the /app/.venv virtualenv managed by uv.
RUN uv pip install --no-cache --python /app/.venv/bin/python \
      cx_Oracle==8.3.0 psycopg2-binary \
    && apt-get autoremove -yqq --purge build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The published image ships translations as .po only: compile the backend
# catalogs (.mo) and the frontend language packs (messages.json).
# pybabel exits non-zero on a few malformed upstream entries but still writes the .mo.
COPY scripts/translations/po_to_json.py /tmp/po_to_json.py
RUN (pybabel compile -d /app/superset/translations -l fr || true) \
    && test -f /app/superset/translations/fr/LC_MESSAGES/messages.mo \
    && python /tmp/po_to_json.py /app/superset/translations \
    && rm -f /tmp/po_to_json.py

USER superset

FROM oracle AS dev
